<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <!--
          Android 11+ hides other packages unless they are declared here. Cloned WeChat keeps the
          base name plus a suffix, so each known variant is listed; without this the module cannot
          resolve a clone's package at all, whatever the LSPosed scope says.
        -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mm.u" />
        <package android:name="com.tencent.mm.s" />
        <package android:name="com.tencent.mm.dual" />
        <package android:name="com.tencent.mm.clone" />
        <package android:name="com.tencent.mm.work" />
        <!--
          Fallback for clone suffixes not enumerated above: a launcher intent query matches any
          package exposing a main launcher activity, so a vendor-specific clone is visible even
          when its exact package name is unknown. The package entries stay because they are
          cheaper and cover the multi-instance spellings directly.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".application.ModuleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/app_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar">

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".activity.MainActivityAlias"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".activity.TransparentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <activity
            android:name=".activity.PipVoipActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${wekitTaskAffinity}"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <receiver
            android:name=".activity.PipVoipActionReceiver"
            android:exported="false" />

        <activity
            android:name=".activity.settings.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.agent.WeAgentSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".features.items.chat.ReadReceiptsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".features.items.system.QrCodeRecordSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.settings.ExtensionsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.scripting_python.PythonScriptsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="51" />
        <!--
          No xposedscope entry on purpose.

          Declaring xposedscope makes LSPosed restrict its scope picker to exactly the listed
          packages, and the underlying resource array has no wildcard form. WeChat clones append
          their own suffix to the package name (com.tencent.mm.u, vendor-specific variants, ...),
          so any list is incomplete by construction and a clone silently never appears in the
          picker. Omitting the declaration makes LSPosed list every installed app, which costs a
          manual search but cannot exclude a valid target.
        -->
    </application>
</manifest>
